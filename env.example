# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (production only; local dev uses SQLite automatically) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Media storage (production only; local dev uses FileSystemStorage automatically) ---
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- CORS (production; local dev defaults to http://localhost:3000) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend base URL, used to build admin draft-preview links ---
FRONTEND_BASE_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
